#!/usr/bin/env bash
# Pre-commit: brza provera (formatiranje izmenjenih Dart fajlova, uvozi tavli_ui).
# Analiza i pogođeni testovi idu u pre-push, ceo skup u CI.
# Uključivanje (jednom po klonu): git config core.hooksPath .githooks
set -euo pipefail

root=$(git rev-parse --show-toplevel)
"$root/scripts/check-staged.sh"
