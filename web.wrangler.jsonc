// Cloudflare Worker "tavli-web" (tavli-web.tavli.workers.dev): the Flutter web
// build (spec 036) as static assets, no Worker code. Deployed only by
// .github/workflows/deploy-web.yml after approval in the `production`
// environment; headers come from build/web/_headers.
{
  "name": "tavli-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./build/web",
    // Flutter uses hash routes (/#/home); a path without a file serves the app
    // instead of an empty response.
    "not_found_handling": "single-page-application"
  }
}
